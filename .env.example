# Public URL prefix. Local dev stays at the origin root.
# On Netsons use the subdirectory, with leading and trailing slashes: /dashboard/
APP_BASE_PATH=/

# FTP account. The host is the server name shown in cPanel, for example prohosting15.netsons.net.
# Port 21 is the FTP port Netsons documents. FTP_SECURE=true uses explicit FTPS.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=true

# Directory under the FTP login root that receives this app.
# Main cPanel user: public_html/dashboard
# FTP user already jailed in public_html: dashboard
# Every deploy deletes everything inside this directory, then uploads the new build.
FTP_REMOTE_DIR=public_html/dashboard

# sqlite keeps local iteration working without MySQL.
# Production on Netsons: DB_DRIVER=mysql and DB_HOST=localhost.
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/dashboard.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
